# Public site URL (use https://www.fogliosinteriors.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner dashboard password
ADMIN_PASSWORD=change-me

# Cookie signing secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Vercel Blob token (required to save uploads / CMS content)
# BLOB_READ_WRITE_TOKEN=

# Contact form — recipient is NEVER shown on the public site
CONTACT_TO_EMAIL=
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Foglio's Website <onboarding@resend.dev>

# Resend inbound forward (blair@fogliosinteriors.com → Proton)
# INBOUND_FORWARD_FROM or CONTACT_FROM_EMAIL must be a verified fogliosinteriors.com sender.
# INBOUND_BLAIR_FORWARD_TO=blair@orbitsecuritygroup.org
# INBOUND_FORWARD_FROM=Foglio's <noreply@fogliosinteriors.com>
# RESEND_WEBHOOK_SECRET=

# Optional public contact / social
# NEXT_PUBLIC_PHONE=
# NEXT_PUBLIC_INSTAGRAM=
# NEXT_PUBLIC_FACEBOOK=

# Optional AdSense (renders only when set)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxx
