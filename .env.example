# Public site URL (use https://www.fogliosinteriors.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner dashboard password
ADMIN_PASSWORD=change-me

# Cookie signing secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Vercel Blob token (required to save uploads / CMS content)
# BLOB_READ_WRITE_TOKEN=

# Contact form — recipient is NEVER shown on the public site
# Human To (owner Hotmail). Do not use Proton or personal Gmail.
CONTACT_TO_EMAIL=Leonard3587@hotmail.com
# RESEND_API_KEY=
# Verified Resend From — transactional send / DKIM on the send subdomain only.
# Never point apex MX at Resend (apex MX is Outlook / Microsoft 365).
# CONTACT_FROM_EMAIL=Foglio's Website <noreply@fogliosinteriors.com>

# Optional Resend inbound webhook. Apex MX is Outlook, so Resend cannot
# receive @fogliosinteriors.com unless Drew adds inbound.* MX (not apex).
# If this webhook is unused, skip these. Forward target is owner Hotmail
# (or Drew can forward M365 → Hotmail instead of this webhook).
# INBOUND_BLAIR_FORWARD_TO=Leonard3587@hotmail.com
# INBOUND_FORWARD_FROM=Foglio's <noreply@fogliosinteriors.com>
# RESEND_WEBHOOK_SECRET=

# Optional public contact / social
# NEXT_PUBLIC_PHONE=
# NEXT_PUBLIC_INSTAGRAM=
# NEXT_PUBLIC_FACEBOOK=

# Optional AdSense (renders only when set)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxx
